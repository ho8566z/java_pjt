    <!-- StudentDao Bean -->
    <bean 
    	id="studentDao" 
    	class="com.office.dw.member.dao.StudentDao" />

	<!-- StudentRegisterService Bean -->
	<bean 
		id="studentRegisterService" 
		class="com.office.dw.member.service.StudentRegisterService">
		<constructor-arg ref="studentDao" />	
	</bean>
	
	<!-- StudentModifyService Bean -->
	<bean 
		id="studentModifyService" 
		class="com.office.dw.member.service.StudentModifyService">
		<constructor-arg ref="studentDao" />
	</bean>
    
    <!-- StudentDeleteService Bean -->
	<bean 
		id="studentDeleteService" 
		class="com.office.dw.member.service.StudentDeleteService">
		<constructor-arg ref="studentDao" />
	</bean>
	
	<!-- StudentSelectService Bean -->
	<bean 
		id="studentSelectService" 
		class="com.office.dw.member.service.StudentSelectService">
		<constructor-arg ref="studentDao" />
	</bean>
	
	<!-- StudentAllSelectService Bean -->
	<bean 
		id="studentAllSelectService" 
		class="com.office.dw.member.service.StudentAllSelectService">
		<constructor-arg ref="studentDao" />
	</bean>
	
	<!-- PrintStudentInformationService Bean -->
	<bean 
		id="printStudentInformationService" 
		class="com.office.dw.member.service.PrintStudentInformationService">
		<constructor-arg ref="studentAllSelectService" />
	</bean>
	
	<!-- DBConnectionInfo Bean -->
	<!-- 개발 DB -->
	<bean 
		id="dev_DBConnectionInfo" 
		class="com.office.dw.member.DBConnectionInfo">
		<property name="url" value="000.000.000.000" />
		<property name="userId" value="admin" />
		<property name="userPw" value="0000" />
	</bean>
	
	<!-- 실제 DB -->
	<bean 
		id="real_DBConnectionInfo" 
		class="com.office.dw.member.DBConnectionInfo">
		<property name="url" value="111.111.111.111" />
		<property name="userId" value="master" />
		<property name="userPw" value="1111" />
	</bean>
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
    
</beans>