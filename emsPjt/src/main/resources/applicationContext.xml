		</property>
	</bean>
    
    <!-- StudentDao Bean -->
    <bean 
    	id="studentDao" 
    	class="com.office.dw.member.dao.StudentDao" />

	<!-- StudentRegisterService Bean -->
	<bean 
		id="studentRegisterService" 
		class="com.office.dw.member.service.StudentRegisterService">
		<constructor-arg ref="studentDao" />	
	</bean>
	
	<!-- StudentModifyService Bean -->
	<bean 
		id="studentModifyService" 
		class="com.office.dw.member.service.StudentModifyService">
		<constructor-arg ref="studentDao" />
	</bean>
    
    <!-- StudentDeleteService Bean -->
	<bean 
		id="studentDeleteService" 
		class="com.office.dw.member.service.StudentDeleteService">
		<constructor-arg ref="studentDao" />
	</bean>
	
	<!-- StudentSelectService Bean -->
	<bean 
		id="studentSelectService" 
		class="com.office.dw.member.service.StudentSelectService">
		<constructor-arg ref="studentDao" />
	</bean>
	
	<!-- StudentAllSelectService Bean -->
	<bean 
		id="studentAllSelectService" 
		class="com.office.dw.member.service.StudentAllSelectService">
		<constructor-arg ref="studentDao" />
	</bean>
	
	<!-- PrintStudentInformationService Bean -->
	<bean 
		id="printStudentInformationService" 
		class="com.office.dw.member.service.PrintStudentInformationService">
		<constructor-arg ref="studentAllSelectService" />
	</bean>
	
	<!-- DBConnectionInfo Bean -->
	<!-- 개발 DB -->
	<bean 
		id="dev_DBConnectionInfo" 
		class="com.office.dw.member.DBConnectionInfo">
		<property name="url" value="000.000.000.000" />
		<property name="userId" value="admin" />
		<property name="userPw" value="0000" />
	</bean>
	
	<!-- 실제 DB -->
	<bean 
		id="real_DBConnectionInfo" 
		class="com.office.dw.member.DBConnectionInfo">
		<property name="url" value="111.111.111.111" />
		<property name="userId" value="master" />
		<property name="userPw" value="1111" />
	</bean>
	
	<!-- EMSInformationService Bean -->
	<bean 
		id="eMSInformationService"
		class="com.office.dw.member.service.EMSInformationService">
		<property name="info" 
		value="Education Management System program was developed in 2022." />
		<property name="copyRight"
		value="COPYRIGHT(C) 2022 EMS CO., LTD. ALL RIGHT RESERVED. CONTACT MASTER FOR MORE INFORMATION." />
		<property name="ver" value="The version is 1.0" />
		<property name="sYear" value="2022" />
		<property name="sMonth" value="3" />
		<property name="sDay" value="1" />
		<property name="eYear" value="2022" />
		<property name="eMonth" value="4" />
		<property name="eDay" value="30" />
		<property name="developers">
			<list>
            	<value>Cheney.</value>
            	<value>Eloy.</value>
            	<value>Jasper.</value>
            	<value>Dillon.</value>
            	<value>Kian.</value>
         	</list>
		</property>

		<!-- administrators 필드 초기화 -->
		<property name="administrators">
			<map>
				<entry>
					<key>
						<value>Cheney</value>
               		</key>
               		<value>cheney@springPjt.org</value>
            	</entry>
            	
            	<entry>
               		<key>
                  		<value>Jasper</value>
               		</key>
               		<value>jasper@springPjt.org</value>
            	</entry>
         	</map>
      	</property>
	
		<!-- dbInfos 필드 초기화 -->
		<property name="dbInfos">
	    	<map>
				<entry>
	               	<key>
	                  	<value>dev</value>
	               	</key>
	               	<ref bean="dev_DBConnectionInfo" />   <!-- 개발용 데이터베이스 지정 -->
	            </entry>
	            
	            <entry>
	               	<key>
	                  	<value>real</value>
	               	</key>
	               	<ref bean="dev_DBConnectionInfo" />   <!-- 실제 서비스 데이터베이스 지정 -->
	            </entry>
	         </map>
		</property>
	</bean>
	
</beans>