<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xsi:schemaLocation="http://www.springframework.org/schema/beans 
    http://www.springframework.org/schema/beans/spring-beans.xsd"> 
	
	<bean id="calAdd" class="com.office.dw.CalAdd" />
	<bean id="calSub" class="com.office.dw.CalSub" />
	<bean id="calMul" class="com.office.dw.CallMul" />
	<bean id="calDiv" class="com.office.dw.CalDiv" />
	
	<bean id="myCalculator" class="com.office.dw.MyCalculator" />
	
	<bean id="calAssembler" class="com.office.dw.CalAssembler" />
		<constructor-arg ref="myCalculator" />
		<constructor-arg ref="calAdd" />
		<constructor-arg ref="calSub" />
		<constructor-arg ref="calMul" />
		<constructor-arg ref="calDiv" />
	</bean>
	
</beans>